JET_ENV=development
JET_DEMO=1
JET_DEBUG=0
JET_ADMIN_TOKEN=CHANGE_TO_A_LONG_RANDOM_SECRET
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_CAMPAIGN_ID=
EBAY_MARKETPLACE=EBAY_US
AWIN_FEED_URL=
PORT=8000

# ---- v10 upgrade layer (all optional; every default is safe) ----
# Optional Claude intent layer. Absent = deterministic rules only, fully working.
ANTHROPIC_API_KEY=
JET_LLM_MODEL=claude-sonnet-4-5
JET_LLM_TIMEOUT=6
JET_LLM_ENABLED=1

# Exchange rates, base ILS. The built-in table is a FALLBACK, not a feed.
# Set real rates before live traffic.
JET_FX_RATES={"USD":3.70,"EUR":4.00,"GBP":4.70}

JET_SEARCH_CACHE_TTL=180
JET_CONNECTOR_CACHE_TTL=300
JET_BREAKER_THRESHOLD=3
JET_BREAKER_RESET_S=60
JET_DNA_HALF_LIFE_DAYS=45
JET_ARENA_MIN_OBS=100
JET_ARENA_EXPLORE=0.10

# Kill switches. JET_UPGRADE=0 disables the whole layer.
JET_UPGRADE=1
JET_UPGRADE_INTENT=1
JET_UPGRADE_SEARCH=1
JET_UPGRADE_FX=1
JET_UPGRADE_ARENA=1
JET_UPGRADE_GATE=1
